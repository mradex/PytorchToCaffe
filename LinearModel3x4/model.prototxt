name: "LinearModel3x4"

layer {
  name: "data"
  type: "Input"
  top: "data"
  #input_param { shape: { dim: 1 dim: 3 } }
  #input_param { shape: { dim: 1 dim:1 dim: 2 dim: 3 } }
  #input_param { shape: { dim: 1 dim:4 dim: 2 dim: 3 } }
  #input_param { shape: { dim: 1 dim:16 dim: 2 dim: 3 } }
  input_param { shape: { dim: 1 dim:17 dim: 2 dim: 3 } }
}

layer {
  name: "fc"
  type: "InnerProduct"
  bottom: "data"
  top: "fc"
  inner_product_param {
    num_output: 4
    bias_term: true 
    weight_filler {
      type: "constant"
      value: 1
    }
    bias_filler {
      type: "constant"
      value: 0 
    }
  }
}
